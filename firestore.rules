rules_version = '2';

// Firestore security rules for the KLH certificate portal.
//
// Design: the browser is trusted with NOTHING by default. All public traffic
// (certificate generation, public verification, the registration form) goes
// through Next.js API routes using the Admin SDK, which bypasses these rules.
//
// The single exception is the admin dashboard's realtime listeners. On login the
// server mints a Firebase custom token carrying an `admin` claim; only a client
// holding that claim may read. Nothing may be written from a browser, ever -
// writes are server-only so validation and audit stay in one place.
//
// Field-level filtering is not possible in rules, which is exactly why the
// public verify page must not read `certificates` directly: those documents
// carry `verification_token`, and granting read would expose it.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /participants/{participantId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /certificates/{certificateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /formSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /formConfig/{configId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
