# ---------------------------------------------------------------------------
# Roster Google Sheet - the participant database.
#
# There is no database server. The app reads this sheet's CSV export on every
# lookup, so an edit in the sheet is live within a minute.
#
# The sheet MUST be shared as "Anyone with the link can view", or the app cannot
# read it and falls back to the roster bundled in lib/db/mock-store.ts.
#
# Recognised columns (any reasonable spelling works - headers are matched
# case- and punctuation-insensitively):
#   Registration ID / Roll Number / Leader Roll ID   (required)
#   Name / Full Name / Leader Name                   (required)
#   Email, Phone, Department, Team Name, Event Name  (optional)
#   Eligible    TRUE/FALSE - omit the column to treat everyone as eligible
#   Revoked     TRUE       - fails public verification for that person
#   Member 2 Name / Member 2 Roll ID ... up to Member 10  (team rows)
# ---------------------------------------------------------------------------
PARTICIPANTS_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# Optional: overrides the event name printed when a row has no Event column.
EVENT_NAME=Smart India Hackathon 2026

# ---------------------------------------------------------------------------
# Certificate signing.
#
# A certificate ID is an HMAC of the registration ID under this secret, which is
# what makes it unforgeable and verifiable without any stored record.
#
# Set this to a long random string and then DO NOT CHANGE IT: every certificate
# already issued verifies against this exact value, so changing it invalidates
# all of them. Generate one with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
CERTIFICATE_SIGNING_SECRET=

# The issue date printed on every certificate and shown on the verification
# page. Fixed per event so a reprint never disagrees with the original.
# Any date string Date() accepts; defaults to the current date when unset.
CERTIFICATE_ISSUE_DATE=2026-08-24

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used to build the QR code's verification URL. Must be the real public origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin portal
# ---------------------------------------------------------------------------
# Verified server-side only; never exposed to the browser.
# The admin portal fails closed - it is unusable while this is unset.
ADMIN_SECRET_KEY=change-me-to-a-strong-passphrase
