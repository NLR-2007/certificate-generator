# ---------------------------------------------------------------------------
# Firebase (Firestore) - the live, shared database.
# Without these the app falls back to an in-memory store: data is lost on
# restart, is NOT shared between serverless instances, and realtime sync is off.
# ---------------------------------------------------------------------------

# Server credentials, from a service account JSON
# (Firebase console > Project settings > Service accounts > Generate new private key).
# FIREBASE_PRIVATE_KEY must stay on ONE line, wrapped in double quotes, with each
# newline written as the two characters backslash + n - exactly as it appears in
# the downloaded JSON. Copy the value straight out of that file.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Browser credentials, used ONLY by the admin dashboard's realtime listeners
# (Firebase console > Project settings > Your apps > Web app config).
# These are safe to expose: Firestore security rules, not these keys, control access.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# Legacy Supabase config - unused, kept only so old deployments do not break.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Website Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis for Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin Master Secret (REQUIRED for the /admin portal).
# Verified server-side only; never exposed to the browser.
# The admin portal fails closed - it is unusable while this is unset.
ADMIN_SECRET_KEY=change-me-to-a-strong-passphrase
