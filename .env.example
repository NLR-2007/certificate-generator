# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Website Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis for Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin Master Secret (REQUIRED for the /admin portal).
# Verified server-side only; never exposed to the browser.
# The admin portal fails closed - it is unusable while this is unset.
ADMIN_SECRET_KEY=change-me-to-a-strong-passphrase
